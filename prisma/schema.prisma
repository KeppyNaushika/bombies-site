generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AchievementMaps {
  id           Int      @id @default(autoincrement())
  roleId       String
  parentRoleId String?
  theme        String?
  description  String?
  priority     Decimal?
  createdAt    DateTime
  updatedAt    DateTime

  @@unique([roleId, theme])
}

model Achievements {
  id                Int      @id @default(autoincrement())
  threadChannelId   String   @unique
  messageId         String
  roleAchievementId String
  memberId          String
  approveMemberIds  String?  // JSONをStringに置き換え
  denyMemberIds     String?  // JSONをStringに置き換え
  createdAt         DateTime
  updatedAt         DateTime
}

model Information {
  id        Int      @id @default(autoincrement())
  item      String   @unique
  content1  String?
  content2  String?
  content3  String?
  content4  String?
  createdAt DateTime
  updatedAt DateTime
}

model PlayerData {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique
  player    String?  // JSONをStringに置き換え
  createdAt DateTime
  updatedAt DateTime
}

model DiscordRoles {
  id              Int      @id @default(autoincrement())
  roleId          String   @unique
  roleType        String
  description     String?
  descriptionJp   String?
  hasColorSkin    Boolean  // Boolean型に置き換え
  colorSkinRoleId String?
  createdAt       DateTime
  updatedAt       DateTime
}

model StatusData {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique
  online    Boolean? // Boolean型に置き換え
  gameType  String?
  mode      String?
  map       String?
  createdAt DateTime
  updatedAt DateTime
}

model Usernames {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  uuid      String
  username  String
  createdAt DateTime
  updatedAt DateTime
}

model DiscordRoleNames {
  id        Int      @id @default(autoincrement())
  roleId    String   @unique
  roleName  String?
  roleColor Decimal?
  createdAt DateTime
  updatedAt DateTime
}

model HypixelPlayerData {
  id   Int    @id @default(autoincrement())
  uuid String @unique
  data String?
  createdAt DateTime
  updatedAt DateTime
}

model Invites {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  memberId  String
  createdAt DateTime
  updatedAt DateTime
}